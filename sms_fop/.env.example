# ------------------------------------------------------------------------------
# Inventory Ledger — environment reference
#
# This file is the SOURCE OF TRUTH for every env var the JAR reads. Copy it to
# `.env` (gitignored) for local dev, or hand it to ops as the contract for
# whatever they wire into the Kubernetes Deployment (Secret + ConfigMap).
#
# Anatomy:
#   - REQUIRED vars have no default in application.yaml. The JAR refuses to
#     start if they are unset. Group: db.*, webhook, files.com creds, app profile.
#   - OPTIONAL vars have a default baked into application.yaml. Listed here for
#     discoverability — only set them when you actually need to override.
#
# Naming: the env var name IS the placeholder in application.yaml. No translation.
# Secrets: never commit a real value. Real values land in .env (gitignored) or
#          the K8s Secret. Placeholder values below use <angle-bracket-hints>.
# ------------------------------------------------------------------------------

# =============================================================================
# REQUIRED — JAR fails fast at startup if any of these are unset
# =============================================================================

# --- App profile ---
APP_PROFILE=prod                  # dev | test | prod (chooses application-<profile>.yaml overlay)

# --- Run mode (ADR-0014) ---
# oneshot   = pipeline runs once and exits (default for dev / test / CI / ad-hoc)
# scheduled = long-running JVM, internal cron scheduler triggers Application.run() (prod default)
# RUN_MODE=scheduled

# --- Internal cron schedules — only honored when RUN_MODE=scheduled ---
# Standard Unix 5-field cron (min hour day month dow).
# Either may be empty string to disable that schedule. At least one must be set.
# SCHEDULE_DAILY=0 6 * * *          # daily at 06:00 — the producer's nominal delivery time
# SCHEDULE_HOURLY=5 * * * *         # hourly catch-up at HH:05 (offset reduces collision with on-the-hour)

# --- /actuator/health HTTP endpoint — only honored when RUN_MODE=scheduled ---
# HEALTH_HOST=0.0.0.0               # bind interface; 0.0.0.0 = all (default for K8s pod IP)
# HEALTH_PORT=8080                  # K8s liveness + readiness probes hit this

# --- External config overlay directory (optional, for K8s centralized config) ---
# CONFIG_DIR=/opt/app/config
# When set, every *.yaml / *.yml file in this directory is loaded in alphabetical
# order and applied as an overlay on top of the classpath defaults. Pattern used
# by the DevOps centralized config-repository: mount common-service-configs.yaml
# + psql-inventory-integration-service.yaml at /opt/app/config and point
# CONFIG_DIR at it. Service file sorts after common file → overrides shared keys.

# --- Database ---
DB_URL=jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
DB_USER=inventoryledger_app
DB_PASSWORD=<rotate-via-vault-or-k8s-secret>

# --- Webhook for failure notifications ---
WEBHOOK_URL_PRIMARY=https://hooks.example.com/inventoryledger

# --- File source (filescom = default) ---
# Required when FILE_SOURCE=filescom (the default).
FILES_COM_API_KEY=<from-files.com-dashboard>
FILES_COM_PICKUP_PATH=/michelin/stocklevel/inbox
FILES_COM_ARCHIVE_PATH=/michelin/stocklevel/archive
FILES_COM_REJECT_PATH=/michelin/stocklevel/reject

# =============================================================================
# OPTIONAL — only set when overriding the YAML default
# =============================================================================

# --- Database tuning ---
# DB_CONNECT_TIMEOUT_S=10
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_APP_NAME=inventoryledger

# --- Flyway ---
# FLYWAY_ENABLED=true                # set false in customer prod — DBServices owns the schema
# FLYWAY_BASELINE_ON_MIGRATE=false
# FLYWAY_VALIDATE_ON_MIGRATE=true

# --- File source selection ---
# FILE_SOURCE=filescom            # filescom (default) | sftp | local
# FILE_NAME_PATTERN=^MICH_INV_STOCKLEVEL_413\d{14}\.dat$

# --- Files.com tuning ---
# FILES_COM_BASE_URL=https://<your-subdomain>.files.com   # blank = SDK default (app.files.com)
# FILES_COM_CONNECT_TIMEOUT_MS=10000
# FILES_COM_READ_TIMEOUT_MS=60000
# FILES_COM_PAGE_SIZE=200

# --- SFTP (only used when FILE_SOURCE=sftp) ---
# SFTP_HOST=sftp.example.com
# SFTP_PORT=22
# SFTP_USER=<sftp-user>
#
# Auth — set EITHER SFTP_PASSWORD or SFTP_PRIVATE_KEY_PATH (key wins if both set).
# SFTP_PASSWORD=<sftp-password>
# SFTP_PRIVATE_KEY_PATH=/secrets/sftp_id_rsa   # PEM file readable by the JAR process
# SFTP_PRIVATE_KEY_PASSPHRASE=                 # leave blank if key is unencrypted
#
# Host-key pinning (production posture). Blank = accept any (dev only — logs warning).
# SFTP_KNOWN_HOSTS_PATH=/secrets/sftp_known_hosts
#
# SFTP_PICKUP_PATH=/inbound
# SFTP_ARCHIVE_PATH=/archive
# SFTP_REJECT_PATH=/rejected
# SFTP_CONNECT_TIMEOUT_MS=10000

# --- Local folder (only used when FILE_SOURCE=local) ---
# LOCAL_PICKUP_PATH=./inbound
# LOCAL_ARCHIVE_PATH=./archive
# LOCAL_REJECT_PATH=./rejected

# --- Webhook tuning ---
# WEBHOOK_MAX_RETRIES=5
# WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_RETRY_BACKOFF_MS=1000
# WEBHOOK_BATCH_SIZE=50
# WEBHOOK_CONNECT_TIMEOUT_MS=5000

# --- Job behavior ---
# EXIT_ON_FIRST_FAILURE=false
# DRAIN_OUTBOX=true
# TEMP_FILE_PREFIX=ob-
# TIMESTAMP_PATTERN=yyyyMMdd_HHmmss

# --- Logging ---
# LOG_FORMAT=json                 # json | text
# LOG_LEVEL=INFO                  # DEBUG | INFO | WARN | ERROR

# --- Synthetic data tools (dev only, never in prod) ---
# TOOLS_SEED=42
