# Postgres 16 + extensions required by the inventory-ledger schema:
#   pg_partman, pg_cron, pgcrypto, pgTAP.
# Used by InventoryLedgerPgContainer (Testcontainers). Built locally:
#   docker build -t inventoryledger-pg:test -f Dockerfile.pgtest .
FROM postgres:16

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        postgresql-16-partman \
        postgresql-16-cron \
        postgresql-16-pgtap \
 && rm -rf /var/lib/apt/lists/*

# Run CREATE EXTENSION + partman schema setup against POSTGRES_DB at first
# boot. Postgres' entrypoint runs /docker-entrypoint-initdb.d/*.sql in
# lexicographic order against POSTGRES_DB (set by Testcontainers).
COPY init-extensions.sql /docker-entrypoint-initdb.d/00-extensions.sql

# shared_preload_libraries is supplied at container start by the test harness
# (see InventoryLedgerPgContainer#withCommand).
